<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>Gen1 Operator Console</title>
    <link rel="stylesheet" href="style.css">
</head>
<body>

    <header>
        <h1>Gen1 Operator Console</h1>
        <p>Interactive Pulse Engine Demo</p>
    </header>

    <section id="operator-panel">
        <button data-op="omega">Ω</button>
        <button data-op="delta">Δ</button>
        <button data-op="phi">Φ</button>
        <button data-op="psi">Ψ</button>
        <button data-op="lambda">Λ</button>
    </section>

    <section id="pulse-visualizer">
        <div id="pulse-circle"></div>
    </section>

    <section id="output-console">
        <h2>Pulse Stream</h2>
        <div id="console-log"></div>
    </section>

    <section id="image-output">
        <h2>Generated Images</h2>
        <div id="image-container"></div>
    </section>

    <script src="app.js"></script>
</body>
</html>

// ===============================
// GEN1 OPERATOR CONSOLE ENGINE
// ===============================

// Operator registry with signatures
const OPERATORS = {
    omega:  { symbol: "Ω", color: "#00d4ff",  signature: [1,0,1,0] },
    delta:  { symbol: "Δ", color: "#ff006e",  signature: [1,1,0,0] },
    phi:    { symbol: "Φ", color: "#ffd60a",  signature: [0,1,1,0] },
    psi:    { symbol: "Ψ", color: "#9d4edd",  signature: [0,0,1,1] },
    lambda: { symbol: "Λ", color: "#4cc9f0",  signature: [1,0,0,1] }
};

// Attach listeners to operator buttons
document.querySelectorAll('#operator-panel button').forEach(btn => {
    btn.addEventListener('click', () => {
        const op = btn.dataset.op;
        invokeOperator(op);
    });
});

// Main operator trigger
function invokeOperator(opName) {
    const op = OPERATORS[opName];
    if (!op) return;

    pulse(op);
    logToConsole(`Operator ${op.symbol} invoked`);
    renderImage(op);
}

// ===============================
// PULSE ENGINE
// ===============================

function pulse(op) {
    const circle = document.getElementById('pulse-circle');

    // Apply operator color
    circle.style.background = op.color;

    // Animate pulse
    circle.classList.add('pulse-active');
    setTimeout(() => circle.classList.remove('pulse-active'), 300);

    // Emit signature to console
    emitSignature(op);
}

function emitSignature(op) {
    const sig = op.signature.join(" ");
    logToConsole(`Signature: [ ${sig} ]`);
}

// ===============================
// CONSOLE STREAM
// ===============================

function logToConsole(text) {
    const log = document.getElementById('console-log');
    const line = document.createElement('div');
    line.className = 'log-line';
    line.textContent = text;
    log.appendChild(line);
    log.scrollTop = log.scrollHeight;
}

// ===============================
// IMAGE GENERATION LANE
// ===============================

function renderImage(op) {
    const container = document.getElementById('image-container');
    const img = document.createElement('div');

    img.className = "gen1-image";
    img.style.borderColor = op.color;
    img.textContent = `Generated: ${op.symbol}`;

    container.appendChild(img);
}

#pulse-circle {
    width: 150px;
    height: 150px;
    border-radius: 50%;
    background: #00d4ff;
    margin: 20px auto;
    transition: transform 0.2s ease, background 0.2s ease;
}

.pulse-active {
    transform: scale(1.25);
}

.gen1-image {
    width: 200px;
    height: 200px;
    border: 4px solid;
    display: flex;
    align-items: center;
    justify-content: center;
    margin: 10px;
    font-size: 20px;
    font-weight: bold;
    border-radius: 12px;
}
