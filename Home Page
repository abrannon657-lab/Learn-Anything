<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>Gen1 Operator Console</title>
    <link rel="stylesheet" href="style.css">
</head>
<body>

    <header>
        <h1>Gen1 Operator Console</h1>
        <p>Interactive Pulse Engine Demo</p>
    </header>

    <section id="operator-panel">
        <button data-op="omega">Ω</button>
        <button data-op="delta">Δ</button>
        <button data-op="phi">Φ</button>
        <button data-op="psi">Ψ</button>
        <button data-op="lambda">Λ</button>
    </section>

    <section id="pulse-visualizer">
        <div id="pulse-circle"></div>
    </section>


    <section id="output-console">
        <h2>Pulse Stream</h2>
        <div id="console-log"></div>
    </section>

    <section id="image-output">
        <h2>Generated Images</h2>
        <div id="image-container"></div>
    </section>

    <script src="app.js"></script>
</body>
</html>
body {
    font-family: system-ui, sans-serif;
    background: #0d0d0f;
    color: #e6e6e6;
    margin: 0;
    padding: 0;
}

header {
    text-align: center;
    padding: 20px 0;
}

#operator-panel {
    display: flex;
    justify-content: center;
    gap: 12px;
    margin: 20px 0;
}

#operator-panel button {
    font-size: 32px;
    padding: 12px 20px;
    background: #1a1a1d;
    border: 1px solid #333;
    color: #fff;
    cursor: pointer;
    border-radius: 6px;
    transition: 0.2s;
}

#operator-panel button:hover {
    background: #333;
}

#pulse-visualizer {
    display: flex;
    justify-content: center;
    margin: 20px 0;
}

#pulse-circle {
    width: 40px;
    height: 40px;
    border-radius: 50%;
    background: #444;
    transition: transform 0.3s ease, background 0.3s ease;
}

#pulse-circle.active {
    transform: scale(1.4);
    background: #00d4ff;
}

#output-console {
    width: 80%;
    margin: 0 auto;
}

#console-log {
    background: #111;
    padding: 15px;
    height: 200px;
    overflow-y: auto;
    border-radius: 6px;
    font-family: monospace;
    font-size: 14px;
}

.log-line {
    margin-bottom: 6px;
}

#image-output {
    width: 80%;
    margin: 30px auto;
}

#image-container img {
    max-width: 200px;
    margin: 10px;
    border-radius: 6px;
    border: 1px solid #333;
}


