<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <title>Gen1 Browser Test</title>
  <link rel="stylesheet" href="gen1.css" />
</head>
<body>

  <header>
    <h1>Gen1 · Browser Test</h1>
    <span id="status">Pulse: Active</span>
  </header>

  <main>
    <section class="panel">
      <h2>Operators</h2>

      <div class="ops">
        <button data-op="infinity">∞ Infinity</button>
        <button data-op="omega">Ω Omega</button>
        <button data-op="delta">Δ Delta</button>
        <button data-op="frog">🐸 Frog</button>
        <button data-op="firefly">✨ Firefly</button>
        <button data-op="idle">⏸ Idle</button>
      </div>

      <div class="controls">
        <button id="recall">Recall</button>
        <button id="jitter">Jitter</button>
      </div>

      <div id="log" class="console"></div>
    </section>

    <section class="panel">
      <h2>Orbit Visualizer</h2>
      <canvas id="gen1-canvas"></canvas>
    </section>
  </main>

  <script src="gen1.js"></script>
</body>
</html>

body {
  margin: 0;
  background: #020617;
  color: #e5e7eb;
  font-family: system-ui, sans-serif;
}

header {
  padding: 12px 20px;
  background: #0f172a;
  border-bottom: 1px solid #1e293b;
  display: flex;
  justify-content: space-between;
  align-items: center;
}

main {
  display: grid;
  grid-template-columns: 280px 1fr;
  gap: 16px;
  padding: 16px;
}

.panel {
  background: #0b1120;
  border: 1px solid #1e293b;
  border-radius: 8px;
  padding: 12px;
}

h2 {
  margin: 0 0 8px;
  font-size: 14px;
  color: #94a3b8;
  text-transform: uppercase;
}

.ops button,
.controls button {
  width: 100%;
  margin-bottom: 6px;
  padding: 8px;
  border-radius: 6px;
  border: 1px solid #334155;
  background: #1e293b;
  color: #e2e8f0;
  cursor: pointer;
}

.ops button.active {
  border-color: #38bdf8;
  background: #0c4a6e;
}

.console {
  margin-top: 10px;
  height: 200px;
  overflow-y: auto;
  font-size: 12px;
  background: #0f172a;
  border: 1px dashed #334155;
  padding: 8px;
}

canvas {
  width: 100%;
  height: 500px;
  background: #000;
  border-radius: 8px;
}