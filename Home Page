body {
    font-family: system-ui, sans-serif;
    background: #0d0d0f;
    color: #e6e6e6;
    margin: 0;
    padding: 0;
}

header {
    text-align: center;
    padding: 20px 0;
}

#operator-panel {
    display: flex;
    justify-content: center;
    gap: 12px;
    margin: 20px 0;
}

#operator-panel button {
    font-size: 32px;
    padding: 12px 20px;
    background: #1a1a1d;
    border: 1px solid #333;
    color: #fff;
    cursor: pointer;
    border-radius: 6px;
    transition: 0.2s;
}

#operator-panel button:hover {
    background: #333;
}

#pulse-visualizer {
    display: flex;
    justify-content: center;
    margin: 20px 0;
}

#pulse-circle {
    width: 40px;
    height: 40px;
    border-radius: 50%;
    background: #444;
    transition: transform 0.3s ease, background 0.3s ease;
}

#pulse-circle.active {
    transform: scale(1.4);
    background: #00d4ff;
}

#output-console {
    width: 80%;
    margin: 0 auto;
}

#console-log {
    background: #111;
    padding: 15px;
    height: 200px;
    overflow-y: auto;
    border-radius: 6px;
    font-family: monospace;
    font-size: 14px;
}

.log-line {
    margin-bottom: 6px;
}

#image-output {
    width: 80%;
    margin: 30px auto;
}

#image-container img {
    max-width: 200px;
    margin: 10px;
    border-radius: 6px;
    border: 1px solid #333;
}
// ===============================
// Gen1 Operator Console – app.js
// ===============================

// --- DOM Elements ---
const pulseCircle = document.getElementById("pulse-circle");
const consoleLog = document.getElementById("console-log");
const imageContainer = document.getElementById("image-container");

// --- Operator Buttons ---
document.querySelectorAll("#operator-panel button").forEach(btn => {
    btn.addEventListener("click", () => {
        const op = btn.dataset.op;
        handleOperator(op);
    });
});

// --- Core Handler ---
function handleOperator(op) {
    pulse();
    logToConsole(`Operator ${op.toUpperCase()} invoked.`);
    generateImage(op);
}

// --- Pulse Animation ---
function pulse() {
    pulseCircle.classList.add("active");
    setTimeout(() => pulseCircle.classList.remove("active"), 300);
}

// --- Console Logging ---
function logToConsole(text) {
    const line = document.createElement("div");
    line.className = "log-line";
    line.textContent = `[${timestamp()}] ${text}`;
    consoleLog.appendChild(line);
    consoleLog.scrollTop = consoleLog.scrollHeight;
}

function timestamp() {
    return new Date().toLocaleTimeString();
}

// --- Image Generation Placeholder ---
function generateImage(op) {
    // Replace this with real Gen1 output later
    const img = document.createElement("img");
    img.src = `https://via.placeholder.com/200x200.png?text=${op}`;
    img.alt = `Generated by ${op}`;
    imageContainer.appendChild(img);
}

function handleOperator(op) {
    pulse(op);

    const meaning = {
        omega:  "Ω → Reset / Ground state",
        delta:  "Δ → Divergence / Branch",
        phi:    "Φ → Harmonic alignment",
        psi:    "Ψ → Projection / Intent",
        lambda: "Λ → Binding / Merge"
    }[op] || "Unknown operator";

    logToConsole(`Operator ${op.toUpperCase()} invoked. ${meaning}`);
    generateImage(op);
}
