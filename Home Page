<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <title>Gen1 Browser Test</title>
  <link rel="stylesheet" href="gen1.css" />
</head>
<body>

  <header>
    <h1>Gen1 · Browser Test</h1>
    <span id="status">Pulse: Active</span>
  </header>

  <main>
    <section class="panel">
      <h2>Operators</h2>

      <div class="ops">
        <button data-op="infinity">∞ Infinity</button>
        <button data-op="omega">Ω Omega</button>
        <button data-op="delta">Δ Delta</button>
        <button data-op="frog">🐸 Frog</button>
        <button data-op="firefly">✨ Firefly</button>
        <button data-op="idle">⏸ Idle</button>
      </div>

      <div class="controls">
        <button id="recall">Recall</button>
        <button id="jitter">Jitter</button>
      </div>

      <div id="log" class="console"></div>
    </section>

    <section class="panel">
      <h2>Orbit Visualizer</h2>
      <canvas id="gen1-canvas"></canvas>
    </section>
  </main>

  <script src="gen1.js"></script>
</body>
</html>

body {
  margin: 0;
  background: #020617;
  color: #e5e7eb;
  font-family: system-ui, sans-serif;
}

header {
  padding: 12px 20px;
  background: #0f172a;
  border-bottom: 1px solid #1e293b;
  display: flex;
  justify-content: space-between;
  align-items: center;
}

main {
  display: grid;
  grid-template-columns: 280px 1fr;
  gap: 16px;
  padding: 16px;
}

.panel {
  background: #0b1120;
  border: 1px solid #1e293b;
  border-radius: 8px;
  padding: 12px;
}

h2 {
  margin: 0 0 8px;
  font-size: 14px;
  color: #94a3b8;
  text-transform: uppercase;
}

.ops button,
.controls button {
  width: 100%;
  margin-bottom: 6px;
  padding: 8px;
  border-radius: 6px;
  border: 1px solid #334155;
  background: #1e293b;
  color: #e2e8f0;
  cursor: pointer;
}

.ops button.active {
  border-color: #38bdf8;
  background: #0c4a6e;
}

.console {
  margin-top: 10px;
  height: 200px;
  overflow-y: auto;
  font-size: 12px;
  background: #0f172a;
  border: 1px dashed #334155;
  padding: 8px;
}

canvas {
  width: 100%;
  height: 500px;
  background: #000;
  border-radius: 8px;
}

const canvas = document.getElementById("gen1-canvas");
const ctx = canvas.getContext("2d");

function resize() {
  canvas.width = canvas.clientWidth;
  canvas.height = canvas.clientHeight;
}
resize();
window.addEventListener("resize", resize);

// --- Gen1 Operator Definitions ---
const operators = {
  infinity: { core: "#7dd3fc", orbit: "#38bdf8", nodes: "#f97316" },
  omega: { core: "#f97316", orbit: "#fb923c", nodes: "#facc15" },
  delta: { core: "#a855f7", orbit: "#e879f9", nodes: "#22c55e" },
  frog: { core: "#22c55e", orbit: "#4ade80", nodes: "#22d3ee" },
  firefly: { core: "#facc15", orbit: "#fde047", nodes: "#22c55e" },
  idle: { core: "#6b7280", orbit: "#4b5563", nodes: "#9ca3af" }
};

let currentOp = "infinity";
let jitter = 0;
let drift = 0;

// --- UI Wiring ---
document.querySelectorAll(".ops button").forEach(btn => {
  btn.addEventListener("click", () => {
    currentOp = btn.dataset.op;
    document.querySelectorAll(".ops button").forEach(b => b.classList.remove("active"));
    btn.classList.add("active");
    log(`Operator → ${currentOp}`);
  });
});

document.getElementById("recall").onclick = () => {
  jitter = 0;
  drift = 0;
  log("RECALL invoked");
};

document.getElementById("jitter").onclick = () => {
  jitter += 0.5;
  log("Jitter added");
};

function log(msg) {
  const el = document.getElementById("log");
  el.innerHTML += `<div>${msg}</div>`;
  el.scrollTop = el.scrollHeight;
}

// --- Orbit Renderer ---
function draw(t) {
  const w = canvas.width;
  const h = canvas.height;
  const cx = w / 2;
  const cy = h / 2;

  ctx.clearRect(0, 0, w, h);

  const op = operators[currentOp];

  drift += 0.001;

  // Orbits
  for (let i = 0; i < 5 + jitter; i++) {
    const r = (i + 1) * 40;
    ctx.beginPath();
    ctx.ellipse(
      cx,
      cy,
      r + Math.sin(t * 0.001 + i) * 10,
      r * 0.6,
      i * 0.3 + drift,
      0,
      Math.PI * 2
    );
    ctx.strokeStyle = op.orbit;
    ctx.lineWidth = 1;
    ctx.stroke();
  }

  // Nodes
  for (let i = 0; i < 20; i++) {
    const angle = t * 0.001 + i;
    const r = 120 + Math.sin(i * 0.5) * 40;
    const x = cx + Math.cos(angle) * r;
    const y = cy + Math.sin(angle * 1.2) * r * 0.6;

    ctx.fillStyle = op.nodes;
    ctx.beginPath();
    ctx.arc(x, y, 4, 0, Math.PI * 2);
    ctx.fill();
  }

  // Core
  ctx.fillStyle = op.core;
  ctx.beginPath();
  ctx.arc(cx, cy, 20, 0, Math.PI * 2);
  ctx.fill();

  requestAnimationFrame(draw);
}

requestAnimationFrame(draw);